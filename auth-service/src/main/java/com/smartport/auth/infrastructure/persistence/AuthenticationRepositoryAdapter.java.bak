package com.smartport.auth.infrastructure.persistence;

import com.smartport.auth.application.ports.outbound.AuthenticationRepository;
import com.smartport.auth.application.shared.LoginUser;
import com.smartport.auth.domain.entities.Email;
import com.smartport.auth.domain.entities.Password;
import com.smartport.auth.domain.entities.PasswordResetToken;
import com.smartport.auth.domain.entities.RefreshToken;
import com.smartport.auth.domain.entities.SetPasswordToken;
import com.smartport.auth.infrastructure.persistence.entity.EmailEntity;
import com.smartport.auth.infrastructure.persistence.entity.PasswordEntity;
import com.smartport.auth.infrastructure.persistence.entity.PasswordResetTokenEntity;
import com.smartport.auth.infrastructure.persistence.entity.RefreshTokenEntity;
import com.smartport.auth.infrastructure.persistence.entity.SetPasswordTokenEntity;
import com.smartport.auth.infrastructure.persistence.repository.EmailJpaRepository;
import com.smartport.auth.infrastructure.persistence.repository.PasswordJpaRepository;
import com.smartport.auth.infrastructure.persistence.repository.PasswordResetTokenJpaRepository;
import com.smartport.auth.infrastructure.persistence.repository.RefreshTokenJpaRepository;
import com.smartport.auth.infrastructure.persistence.repository.SetPasswordTokenJpaRepository;
import java.util.Optional;
import java.util.UUID;
import lombok.RequiredArgsConstructor;
import org.springframework.beans.BeanUtils;
import org.springframework.stereotype.Repository;
import org.springframework.transaction.annotation.Transactional;

/** Oracle/JPA implementation of the AuthenticationRepository port (was AuthenticationRepository.cs). */
@Repository
@Transactional
@RequiredArgsConstructor
public class AuthenticationRepositoryAdapter implements AuthenticationRepository {

    private static final String PASSWORD_ALGORITHM = "BCrypt";

    private final EmailJpaRepository emails;
    private final PasswordJpaRepository passwords;
    private final RefreshTokenJpaRepository refreshTokens;
    private final PasswordResetTokenJpaRepository passwordResetTokens;
    private final SetPasswordTokenJpaRepository setPasswordTokens;

    // domain and entity classes share property names, so BeanUtils does the mapping
    private static <T> T copy(Object source, T target) {
        BeanUtils.copyProperties(source, target);
        return target;
    }

    // ------------------------------------------------------------------ users

    @Override
    @Transactional(readOnly = true)
    public Optional<LoginUser> getByEmail(String email) {
        return emails.findFirstByEmailAddressAndDeletedFalse(email)
                .flatMap(e -> passwords
                        .findFirstByUserIdAndActiveTrueAndDeletedFalse(e.getUserId())
                        .map(p -> new LoginUser(e.getUserId(), e.getEmailAddress(), p.getPasswordHash())));
    }

    @Override
    @Transactional(readOnly = true)
    public Optional<UUID> getUserIdByEmail(String email) {
        return emails.findFirstByEmailAddressAndDeletedFalse(email).map(EmailEntity::getUserId);
    }

    @Override
    public void saveEmail(Email email) {
        emails.save(copy(email, new EmailEntity()));
    }

    @Override
    public void savePassword(Password password) {
        passwords.save(copy(password, new PasswordEntity()));
    }

    @Override
    @Transactional(readOnly = true)
    public boolean hasActivePassword(UUID userId) {
        return passwords.existsByUserIdAndActiveTrue(userId);
    }

    @Override
    public void setPassword(UUID userId, String passwordHash) {
        passwords.save(newActivePassword(userId, passwordHash));
    }

    @Override
    public void resetPassword(UUID userId, String passwordHash) {
        passwords.findByUserIdAndActiveTrue(userId).forEach(p -> p.setActive(false));
        passwords.save(newActivePassword(userId, passwordHash));
    }

    private static PasswordEntity newActivePassword(UUID userId, String passwordHash) {
        PasswordEntity entity = new PasswordEntity();
        entity.setPasswordId(UUID.randomUUID());
        entity.setUserId(userId);
        entity.setPasswordHash(passwordHash);
        entity.setPasswordAlgorithm(PASSWORD_ALGORITHM);
        entity.setActive(true);
        entity.setDeleted(false);
        return entity;
    }

    // ---------------------------------------------------------- refresh tokens

    @Override
    public void saveRefreshToken(RefreshToken refreshToken) {
        refreshTokens.save(copy(refreshToken, new RefreshTokenEntity()));
    }

    @Override
    @Transactional(readOnly = true)
    public Optional<RefreshToken> getRefreshToken(String token) {
        return refreshTokens.findActiveByToken(token).map(e -> copy(e, new RefreshToken()));
    }

    @Override
    public void updateRefreshToken(RefreshToken refreshToken) {
        refreshTokens.save(copy(refreshToken, new RefreshTokenEntity()));
    }

    // ------------------------------------------------------ set-password tokens

    @Override
    public void saveSetPasswordToken(SetPasswordToken token) {
        setPasswordTokens.save(copy(token, new SetPasswordTokenEntity()));
    }

    @Override
    @Transactional(readOnly = true)
    public Optional<SetPasswordToken> getSetPasswordToken(String token) {
        return setPasswordTokens.findFirstByTokenAndUsedFalse(token)
                .map(e -> copy(e, new SetPasswordToken()));
    }

    @Override
    public void updateSetPasswordToken(SetPasswordToken token) {
        setPasswordTokens.save(copy(token, new SetPasswordTokenEntity()));
    }

    // ---------------------------------------------------- password-reset tokens

    @Override
    public void savePasswordResetToken(PasswordResetToken token) {
        passwordResetTokens.save(copy(token, new PasswordResetTokenEntity()));
    }

    @Override
    @Transactional(readOnly = true)
    public Optional<PasswordResetToken> getPasswordResetToken(String token) {
        return passwordResetTokens.findFirstByTokenAndUsedFalse(token)
                .map(e -> copy(e, new PasswordResetToken()));
    }

    @Override
    public void updatePasswordResetToken(PasswordResetToken token) {
        passwordResetTokens.save(copy(token, new PasswordResetTokenEntity()));
    }

    @Override
    public void invalidatePasswordResetTokens(UUID userId) {
        passwordResetTokens.markAllUsedByUserId(userId);
    }
}
